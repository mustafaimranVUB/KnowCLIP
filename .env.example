# Environment Variables for KnoCLIP-XAI

# UMLS API Key (required for downloading UMLS data)
# Get your API key from https://uts.nlm.nih.gov/uts/
UMLS_API_KEY=your_umls_api_key_here
HF_TOKEN=your Hugging face token here

# Optional: Configure dataset paths
DATASET_DIR=Mimic dataset directory path
MRCONSO_PATH=path to MRCONSO.RRF

# Optional: Pipeline configuration
# OUTPUT_DIR=data/outputs/KG
# RADGRAPH_MODEL=modern-radgraph-xl
# RANDOM_SEED=42
