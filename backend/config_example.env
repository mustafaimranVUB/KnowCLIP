# KnoCLIP-XAI Backend Configuration
# Copy this file to .env, edit the paths, then:
#   set -a && source .env && set +a && bash backend/start.sh
#
# On a client GPU box the easiest path is backend/run_local.sh (it sets these for you).
# This file is for running backend/start.sh directly.

# --- Required ---
# Config ships with the repo under configs/. This is the chosen impression-conditioned
# neuro-symbolic model (run ablation_genw025, macro AUC 0.9341).
MODEL_CONFIG=configs/hydra_phase2_neurosymbolic_gpt2_jpg_impression_clinical_v1.yaml
# Checkpoint lives under the outputs root, NOT in the repo — point this at your copy.
MODEL_CHECKPOINT=/abs/path/to/outputs/checkpoints/ablation_genw025/best_model.pt

# --- Optional ---
# KG artifacts (impression build). Only needed for the KG Explorer card; /predict works
# without it. Leave unset to disable the KG tabs.
KG_ARTIFACTS_DIR=/abs/path/to/outputs/KG
HOST=0.0.0.0
PORT=8000
# DEVICE: cuda:0 for GPU (default). Leave blank to auto-detect, or set cpu to force CPU.
DEVICE=cuda:0
LOG_LEVEL=info
